rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    // Validation Blueprint: UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: CitySave
    function isValidCitySave(data) {
      return data.keys().hasAll([
          'ownerId', 'cityName', 'mayorName', 'population', 'treasury',
          'popularity', 'day', 'month', 'year', 'developmentLevel',
          'stateSnapshot', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'cityName', 'mayorName', 'population', 'treasury',
          'popularity', 'day', 'month', 'year', 'developmentLevel',
          'stateSnapshot', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.cityName is string && data.cityName.size() >= 1 && data.cityName.size() <= 80
        && data.mayorName is string && data.mayorName.size() >= 1 && data.mayorName.size() <= 80
        && data.population is number && data.population >= 0 && data.population <= 100000000
        && data.treasury is number && data.treasury >= -1000000000 && data.treasury <= 100000000000
        && data.popularity is number && data.popularity >= 0 && data.popularity <= 100
        && data.day is number && data.day >= 1 && data.day <= 31
        && data.month is number && data.month >= 1 && data.month <= 12
        && data.year is number && data.year >= 1 && data.year <= 9999
        && data.developmentLevel is number && data.developmentLevel >= 1 && data.developmentLevel <= 6
        && data.stateSnapshot is map
        && data.stateSnapshot.keys().size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: CityLegacy
    function isValidCityLegacy(data) {
      return data.keys().hasAll([
          'ownerId', 'cityName', 'mayorName', 'outcome', 'finalPopulation',
          'finalTreasury', 'finalPopularity', 'yearsServed', 'summary', 'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'cityName', 'mayorName', 'outcome', 'finalPopulation',
          'finalTreasury', 'finalPopularity', 'yearsServed', 'summary', 'createdAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.cityName is string && data.cityName.size() >= 1 && data.cityName.size() <= 80
        && data.mayorName is string && data.mayorName.size() >= 1 && data.mayorName.size() <= 80
        && data.outcome in ['reelected', 'election_loss', 'impeached', 'resigned', 'collapsed']
        && data.finalPopulation is number && data.finalPopulation >= 0
        && data.finalTreasury is number
        && data.finalPopularity is number && data.finalPopularity >= 0 && data.finalPopularity <= 100
        && data.yearsServed is number && data.yearsServed >= 0
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 500
        && data.createdAt is timestamp;
    }

    // /users/{userId}
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && isOwner(existing().uid)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // /cities/{cityId}
    match /cities/{cityId} {
      allow get: if isSignedIn() && isValidId(cityId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(cityId)
        && isValidCitySave(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(cityId)
        && isValidCitySave(incoming())
        && isOwner(existing().ownerId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'cityName', 'mayorName', 'population', 'treasury', 'popularity',
          'day', 'month', 'year', 'developmentLevel', 'stateSnapshot', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(cityId) && existing().ownerId == request.auth.uid;
    }

    // /legacies/{legacyId}
    match /legacies/{legacyId} {
      allow get: if isSignedIn() && isValidId(legacyId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(legacyId)
        && isValidCityLegacy(incoming())
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isSignedIn() && isValidId(legacyId) && existing().ownerId == request.auth.uid;
    }
  }
}
